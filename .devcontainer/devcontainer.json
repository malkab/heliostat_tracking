{
    "dockerComposeFile": "docker-compose.yml",
    "service": "python",
    "workspaceFolder": "${localWorkspaceFolder}",
    "name": "heliostat_tracking_python",
    "features": {},
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "donjayamanne.python-environment-manager",
                "GitHub.copilot-chat",
                "GitHub.copilot",
                "mhutchie.git-graph",
                "ms-python.black-formatter",
                "ms-python.debugpy",
                "ms-python.pylint",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "njpwerner.autodocstring",
                "stkb.rewrap"
            ],
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            }
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "PYTHONPATH": "${localWorkspaceFolder}/src/",
        "PATH": "${localEnv:PATH}:/home/vscode/.local/bin:/usr/local/bin"
    },
    "mounts": [
        "type=bind,source=${localWorkspaceFolder},target=${localWorkspaceFolder}"
        // Examples
        // "type=bind,source=${localWorkspaceFolder}/configs/config.yaml,target=/config.yaml,readonly",
        // "type=bind,source=${localWorkspaceFolder}/000_docker_volumes/ssparc,target=/ssparc"
    ]
    // A good place to change ownership of mounted volumes
    // "postCreateCommand": "sudo chown -R vscode:vscode /ssparc",
    // Example of running a script
    // "postCreateCommand": "./.devcontainer/assets/postcreatecommand.sh"
    // A good place to run post-build commands
    // "initializeCommand": "echo POST_INIT"
}
